# Used by docker-compose.yml itself (variable interpolation at the
# `${VAR}` sites in that file) - copy to `.env` in this same directory
# and fill in real values. This is separate from backend/.env and
# frontend/.env, which configure the applications themselves.
#
# docker compose automatically loads a file named exactly `.env` from
# the same directory as docker-compose.yml - no extra flag needed.

# ── MinIO (bundled S3-compatible object storage) ──
# Also becomes the backend's S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
# automatically (see docker-compose.yml) - defined once here, not
# duplicated into backend/.env.
MINIO_ROOT_USER=CHANGE_ME_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_at_least_8_characters
S3_BUCKET_NAME=jaz-attachments

# ── Frontend build ──
# Leave empty for the recommended same-origin nginx-proxy setup (see
# frontend/nginx.conf). Set to a full URL only if the frontend and
# backend will be served from different domains/ports.
REACT_APP_BACKEND_URL=

# ── Networking ──
# Host port the frontend (nginx) is published on. Change to 8080, etc.
# if port 80 is already in use, or if an external reverse proxy /
# load balancer in front of this VPS handles TLS termination and
# forwards to this port.
HTTP_PORT=80
