# Copy this file to `.env` in the same directory and fill in real values.
# Never commit the real `.env` - it's already gitignored.

# ── Core ──
ENVIRONMENT=production

# Supabase: use the "Connection pooling" (or direct) connection string from
# Project Settings > Database, rewritten for SQLAlchemy's async driver:
#   postgresql+asyncpg://postgres:<password>@<host>:5432/postgres?ssl=require
# The `+asyncpg` and `?ssl=require` are both required - Supabase enforces
# TLS, and the driver segment tells SQLAlchemy which async driver to use.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@CHANGE_ME.supabase.co:5432/postgres?ssl=require

# Generate with: openssl rand -hex 32
# The app refuses to start without a real value here - there is no
# insecure default.
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE

# Comma-separated, no trailing slashes, no wildcards. Must list every
# origin the frontend is actually served from. In production the app
# refuses to start with this unset. If you're using the bundled
# frontend/nginx.conf reverse proxy (recommended - see docker-compose.yml),
# this only needs to list the public URL(s) users load the app from.
CORS_ORIGINS=https://your-production-domain.example.com

# ── Object storage (S3-compatible) ──
# When using docker-compose.yml as provided, these three are supplied
# automatically from the bundled MinIO service (see the root .env.example)
# - leave them unset here. Only set them here if pointing directly at an
# external provider (AWS S3, Supabase Storage's S3-compatible endpoint,
# etc.) instead of the bundled MinIO container.
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=us-east-1

# ── Stripe (subscription billing) ──
# Both optional - subscription checkout/webhook features return a clean
# "not configured" error instead of failing if these are left unset.
# STRIPE_API_KEY=sk_live_...
# From the Stripe Dashboard webhook endpoint you create for
# https://your-domain/api/webhook/stripe - required for that endpoint to
# accept anything; without it, forged webhooks are rejected outright
# rather than trusted.
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Push notifications (Firebase Cloud Messaging) ──
# Optional - push notifications are silently disabled if neither is set.
# Paste the full service-account JSON as one line (convenient for
# containers - no file to mount).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
