# For local (non-Docker) development only: copy to `.env` in this
# directory and run `yarn start`/`yarn build` directly.
#
# When building via docker-compose.yml, this file is NOT used - the
# equivalent value is passed as a build argument from the repository
# root's `.env` instead (see REACT_APP_BACKEND_URL there and
# frontend/Dockerfile's ARG). Keep both in sync if you set a non-empty
# value for a split-domain deployment.

REACT_APP_BACKEND_URL=http://localhost:8000
